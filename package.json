{
  "name": "my-gen",
  "version": "0.3.14",
  "description": "A CLI to run commands reading a simple DSL.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gen": "dist/index.js"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "postpublish": "git push && git push --tags",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish"
  },
  "dependencies": {
    "@opentui/core": "^0.8.0",
    "cross-spawn": "^7.0.6",
    "degit": "^2.8.4",
    "ollama": "^0.5.18",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/degit": "^2.8.6",
    "@types/node": "^20.19.17",
    "@types/yargs": "^17.0.32",
    "typescript": "^5.4.5"
  },
  "directories": {
    "doc": "doc",
    "example": "templates",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LorenzoCorbella74/my-gen.git"
  },
  "keywords": [],
  "author": "LorenzoCorbella74",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/LorenzoCorbella74/my-gen/issues"
  },
  "homepage": "https://github.com/LorenzoCorbella74/my-gen#readme",
  "engines": {
    "bun": ">=1.3.14"
  }
}
